<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SCADA.ViewModels"
             xmlns:controls="using:SCADA.Views.Controls"
             x:Class="SCADA.Views.ControlTabView"
             x:DataType="vm:KinematicsViewModel">

    <Grid ColumnDefinitions="480,*" Margin="16" ColumnSpacing="16">
        <!-- Left Column: Kinematics & Control Panels (Scrollable) -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Margin="0,0,8,0">

                <!-- 1. FORWARD KINEMATICS (ĐỘNG HỌC THUẬN) -->
                <Border Background="#1E293B" CornerRadius="8" Padding="14" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="🔄 ĐỘNG HỌC THUẬN (FORWARD KINEMATICS - FK)" FontWeight="Bold" FontSize="13" Foreground="#38BDF8"/>
                        
                        <!-- Q1 Slider -->
                        <Grid ColumnDefinitions="55,*,65" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Q1 (Base):" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11"/>
                            <Slider Grid.Row="0" Grid.Column="1" Minimum="{Binding Robot.Q1Min}" Maximum="{Binding Robot.Q1Max}" Value="{Binding Robot.Q1}" Margin="6,0"/>
                            <NumericUpDown Grid.Row="0" Grid.Column="2" Value="{Binding Robot.Q1}" Minimum="{Binding Robot.Q1Min}" Maximum="{Binding Robot.Q1Max}" FormatString="0.0" Height="28"/>
                        </Grid>

                        <!-- Q2 Slider -->
                        <Grid ColumnDefinitions="55,*,65" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Q2 (Shoulder):" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11"/>
                            <Slider Grid.Row="0" Grid.Column="1" Minimum="{Binding Robot.Q2Min}" Maximum="{Binding Robot.Q2Max}" Value="{Binding Robot.Q2}" Margin="6,0"/>
                            <NumericUpDown Grid.Row="0" Grid.Column="2" Value="{Binding Robot.Q2}" Minimum="{Binding Robot.Q2Min}" Maximum="{Binding Robot.Q2Max}" FormatString="0.0" Height="28"/>
                        </Grid>

                        <!-- Q3 Slider -->
                        <Grid ColumnDefinitions="55,*,65" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Q3 (Elbow):" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11"/>
                            <Slider Grid.Row="0" Grid.Column="1" Minimum="{Binding Robot.Q3Min}" Maximum="{Binding Robot.Q3Max}" Value="{Binding Robot.Q3}" Margin="6,0"/>
                            <NumericUpDown Grid.Row="0" Grid.Column="2" Value="{Binding Robot.Q3}" Minimum="{Binding Robot.Q3Min}" Maximum="{Binding Robot.Q3Max}" FormatString="0.0" Height="28"/>
                        </Grid>

                        <!-- Q4 Slider -->
                        <Grid ColumnDefinitions="55,*,65" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Q4 (Wrist):" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11"/>
                            <Slider Grid.Row="0" Grid.Column="1" Minimum="{Binding Robot.Q4Min}" Maximum="{Binding Robot.Q4Max}" Value="{Binding Robot.Q4}" Margin="6,0"/>
                            <NumericUpDown Grid.Row="0" Grid.Column="2" Value="{Binding Robot.Q4}" Minimum="{Binding Robot.Q4Min}" Maximum="{Binding Robot.Q4Max}" FormatString="0.0" Height="28"/>
                        </Grid>

                        <!-- Resulting Cartesian Coordinates Readout -->
                        <Border Background="#0F172A" CornerRadius="6" Padding="10" BorderBrush="#334155" BorderThickness="1">
                            <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="X (mm)" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Robot.X, StringFormat='{}{0:F1}'}" Foreground="#38BDF8" FontWeight="Bold" HorizontalAlignment="Center"/>

                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Y (mm)" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Robot.Y, StringFormat='{}{0:F1}'}" Foreground="#38BDF8" FontWeight="Bold" HorizontalAlignment="Center"/>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Z (mm)" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Robot.Z, StringFormat='{}{0:F1}'}" Foreground="#38BDF8" FontWeight="Bold" HorizontalAlignment="Center"/>

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Pitch (°)" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Robot.Pitch, StringFormat='{}{0:F1}'}" Foreground="#F59E0B" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Action Buttons -->
                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                            <Button Grid.Column="0" Content="Tính FK" Command="{Binding CalculateFkCommand}" Background="#0284C7" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="Gửi tới Robot" Command="{Binding SendFkToRobotCommand}" Background="#059669" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                            <CheckBox Grid.Column="2" Content="Auto Sync" IsChecked="{Binding AutoSyncWithModbus}" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. INVERSE KINEMATICS (ĐỘNG HỌC NGƯỢC) -->
                <Border Background="#1E293B" CornerRadius="8" Padding="14" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="🎯 ĐỘNG HỌC NGƯỢC (INVERSE KINEMATICS - IK)" FontWeight="Bold" FontSize="13" Foreground="#38BDF8"/>
                        
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Target X (mm)" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                <NumericUpDown Value="{Binding Robot.TargetX}" Increment="5.0" FormatString="0.0" Height="28"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Target Y (mm)" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                <NumericUpDown Value="{Binding Robot.TargetY}" Increment="5.0" FormatString="0.0" Height="28"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Target Z (mm)" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                <NumericUpDown Value="{Binding Robot.TargetZ}" Increment="5.0" FormatString="0.0" Height="28"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Pitch (°)" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                <NumericUpDown Value="{Binding Robot.TargetPitch}" Increment="5.0" FormatString="0.0" Height="28"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                            <TextBlock Text="Cấu hình khủy tay:" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11"/>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ElbowUp}" OnContent="Elbow UP (Khủy Lên)" OffContent="Elbow DOWN (Khủy Xuống)"/>
                        </Grid>

                        <!-- IK Calculated Joint Angles Readout -->
                        <Border Background="#0F172A" CornerRadius="6" Padding="10" BorderBrush="#334155" BorderThickness="1">
                            <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Q1 Target" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Robot.TargetQ1, StringFormat='{}{0:F1}°'}" Foreground="#10B981" FontWeight="Bold" HorizontalAlignment="Center"/>

                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Q2 Target" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Robot.TargetQ2, StringFormat='{}{0:F1}°'}" Foreground="#10B981" FontWeight="Bold" HorizontalAlignment="Center"/>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Q3 Target" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Robot.TargetQ3, StringFormat='{}{0:F1}°'}" Foreground="#10B981" FontWeight="Bold" HorizontalAlignment="Center"/>

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Q4 Target" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Robot.TargetQ4, StringFormat='{}{0:F1}°'}" Foreground="#10B981" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding IkStatusMessage}" FontSize="11"
                                   Foreground="{Binding IkStatusColor}" 
                                   TextWrapping="Wrap"/>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Content="Tính IK (Solve)" Command="{Binding CalculateIkCommand}" Background="#6366F1" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="Áp dụng tới Robot" Command="{Binding ApplyIkToRobotCommand}" Background="#059669" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. JOGGING CONTROL (ĐIỀU KHIỂN JOG) -->
                <Border Background="#1E293B" CornerRadius="8" Padding="14" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="🕹️ ĐIỀU KHIỂN JOG (JOGGING CONTROLLER)" FontWeight="Bold" FontSize="13" Foreground="#38BDF8"/>
                            <Button Grid.Column="1" Content="Kẹp / Nhả Gripper"
                                    Command="{Binding ToggleGripperCommand}"
                                    Background="#0284C7"
                                    Foreground="White" Padding="10,4" FontSize="11"/>
                        </Grid>

                        <!-- Joint Jog Panel -->
                        <TextBlock Text="Jog Khớp (Joint Jog):" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                            <!-- J1 -->
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Joint 1" HorizontalAlignment="Center" FontSize="10" Foreground="#64748B"/>
                                <Button Content="J1 +" Command="{Binding JogJointCommand}" CommandParameter="1+" Background="#334155" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="28"/>
                                <Button Content="J1 -" Command="{Binding JogJointCommand}" CommandParameter="1-" Background="#1E293B" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="28"/>
                            </StackPanel>
                            <!-- J2 -->
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Joint 2" HorizontalAlignment="Center" FontSize="10" Foreground="#64748B"/>
                                <Button Content="J2 +" Command="{Binding JogJointCommand}" CommandParameter="2+" Background="#334155" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="28"/>
                                <Button Content="J2 -" Command="{Binding JogJointCommand}" CommandParameter="2-" Background="#1E293B" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="28"/>
                            </StackPanel>
                            <!-- J3 -->
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="Joint 3" HorizontalAlignment="Center" FontSize="10" Foreground="#64748B"/>
                                <Button Content="J3 +" Command="{Binding JogJointCommand}" CommandParameter="3+" Background="#334155" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="28"/>
                                <Button Content="J3 -" Command="{Binding JogJointCommand}" CommandParameter="3-" Background="#1E293B" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="28"/>
                            </StackPanel>
                            <!-- J4 -->
                            <StackPanel Grid.Column="3" Spacing="4">
                                <TextBlock Text="Joint 4" HorizontalAlignment="Center" FontSize="10" Foreground="#64748B"/>
                                <Button Content="J4 +" Command="{Binding JogJointCommand}" CommandParameter="4+" Background="#334155" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="28"/>
                                <Button Content="J4 -" Command="{Binding JogJointCommand}" CommandParameter="4-" Background="#1E293B" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="28"/>
                            </StackPanel>
                        </Grid>

                        <!-- Cartesian Jog Panel -->
                        <TextBlock Text="Jog Tọa độ Đề-các (Cartesian Jog):" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                            <!-- X -->
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Trục X" HorizontalAlignment="Center" FontSize="10" Foreground="#64748B"/>
                                <Button Content="X +" Command="{Binding JogCartesianCommand}" CommandParameter="X+" Background="#EF4444" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="28"/>
                                <Button Content="X -" Command="{Binding JogCartesianCommand}" CommandParameter="X-" Background="#991B1B" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="28"/>
                            </StackPanel>
                            <!-- Y -->
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Trục Y" HorizontalAlignment="Center" FontSize="10" Foreground="#64748B"/>
                                <Button Content="Y +" Command="{Binding JogCartesianCommand}" CommandParameter="Y+" Background="#10B981" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="28"/>
                                <Button Content="Y -" Command="{Binding JogCartesianCommand}" CommandParameter="Y-" Background="#065F46" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="28"/>
                            </StackPanel>
                            <!-- Z -->
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="Trục Z" HorizontalAlignment="Center" FontSize="10" Foreground="#64748B"/>
                                <Button Content="Z +" Command="{Binding JogCartesianCommand}" CommandParameter="Z+" Background="#3B82F6" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="28"/>
                                <Button Content="Z -" Command="{Binding JogCartesianCommand}" CommandParameter="Z-" Background="#1E40AF" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="28"/>
                            </StackPanel>
                            <!-- Pitch -->
                            <StackPanel Grid.Column="3" Spacing="4">
                                <TextBlock Text="Pitch" HorizontalAlignment="Center" FontSize="10" Foreground="#64748B"/>
                                <Button Content="P +" Command="{Binding JogCartesianCommand}" CommandParameter="P+" Background="#F59E0B" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="28"/>
                                <Button Content="P -" Command="{Binding JogCartesianCommand}" CommandParameter="P-" Background="#B45309" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="28"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. JACOBIAN & DYNAMICS MONITOR (MA TRẬN JACOBY & ĐỘNG LỰC HỌC) -->
                <Border Background="#1E293B" CornerRadius="8" Padding="14" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="⚙️ MA TRẬN JACOBIAN &amp; ĐỘNG LỰC HỌC (DYNAMICS)" FontWeight="Bold" FontSize="13" Foreground="#38BDF8"/>
                        
                        <!-- Singularity Alert -->
                        <Border Background="#0F172A" CornerRadius="6" Padding="8" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding SingularityWarning}" FontWeight="SemiBold" FontSize="11" Foreground="#F59E0B"/>
                                <Grid ColumnDefinitions="*,*">
                                    <TextBlock Grid.Column="0" Text="{Binding Determinant, StringFormat='Det(J): {0:E2}'}" Foreground="#94A3B8" FontSize="10"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Manipulability, StringFormat='Manipulability w: {0:F3}'}" Foreground="#94A3B8" FontSize="10"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Dynamic Torques -->
                        <Border Background="#0F172A" CornerRadius="6" Padding="8" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Mô-men khớp Euler-Lagrange (Torque):" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="*,*,*,*">
                                    <TextBlock Grid.Column="0" Text="{Binding Robot.Tau1, StringFormat='τ1: {0:F2} N·m'}" Foreground="#38BDF8" FontSize="10"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Robot.Tau2, StringFormat='τ2: {0:F2} N·m'}" Foreground="#F97316" FontSize="10"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Robot.Tau3, StringFormat='τ3: {0:F2} N·m'}" Foreground="#10B981" FontSize="10"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Robot.Tau4, StringFormat='τ4: {0:F2} N·m'}" Foreground="#8B5CF6" FontSize="10"/>
                                </Grid>
                                <TextBlock Text="{Binding Robot.TotalPowerWatts, StringFormat='Tổng công suất cơ học: {0:F2} W'}" Foreground="#E2E8F0" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 5. DENAVIT-HARTENBERG TABLE (BẢNG D-H) -->
                <Border Background="#1E293B" CornerRadius="8" Padding="14" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="📐 THÔNG SỐ DENAVIT-HARTENBERG (D-H PARAMETERS)" FontWeight="Bold" FontSize="13" Foreground="#38BDF8"/>
                        
                        <DataGrid ItemsSource="{Binding DhRows}" AutoGenerateColumns="False" IsReadOnly="True"
                                  GridLinesVisibility="All" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" Height="140">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Link i" Binding="{Binding LinkIndex}" Width="50"/>
                                <DataGridTextColumn Header="Khớp (Joint)" Binding="{Binding JointName}" Width="130"/>
                                <DataGridTextColumn Header="θi (°)" Binding="{Binding ThetaDeg, StringFormat='{}{0:F1}'}" Width="65"/>
                                <DataGridTextColumn Header="di (mm)" Binding="{Binding D, StringFormat='{}{0:F1}'}" Width="65"/>
                                <DataGridTextColumn Header="ai (mm)" Binding="{Binding A, StringFormat='{}{0:F1}'}" Width="65"/>
                                <DataGridTextColumn Header="αi (°)" Binding="{Binding AlphaDeg, StringFormat='{}{0:F1}'}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Right Column: 2D/3D Kinematic Visualizer Canvas & Controls -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <!-- Visualizer Toolbar -->
            <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="10,6" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- View Mode Selector -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Góc nhìn:" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" Margin="0,0,4,0"/>
                        <Button Content="3D Orbit" Command="{Binding SetViewModeCommand}" CommandParameter="Isometric" Background="#334155" Foreground="White" Padding="8,4" FontSize="11"/>
                        <Button Content="2D Side (R-Z)" Command="{Binding SetViewModeCommand}" CommandParameter="Side" Background="#334155" Foreground="White" Padding="8,4" FontSize="11"/>
                        <Button Content="2D Top (X-Y)" Command="{Binding SetViewModeCommand}" CommandParameter="Top" Background="#334155" Foreground="White" Padding="8,4" FontSize="11"/>
                    </StackPanel>

                    <!-- View Options -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <CheckBox Content="Ghost Target" IsChecked="{Binding ShowGhostArm}" Foreground="#94A3B8" FontSize="12"/>
                        <CheckBox Content="Trail" IsChecked="{Binding ShowTrail}" Foreground="#94A3B8" FontSize="12"/>
                        <CheckBox Content="Workspace" IsChecked="{Binding ShowWorkspaceBoundary}" Foreground="#94A3B8" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Vector Canvas Visualizer -->
            <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" ClipToBounds="True" BorderBrush="#334155" BorderThickness="1">
                <controls:RobotCanvasControl Robot="{Binding Robot}"
                                             ViewMode="{Binding ViewMode}"
                                             ShowGhostArm="{Binding ShowGhostArm}"
                                             ShowTrail="{Binding ShowTrail}"
                                             ShowWorkspaceBoundary="{Binding ShowWorkspaceBoundary}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
