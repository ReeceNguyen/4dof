<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SCADA.ViewModels"
             xmlns:controls="using:SCADA.Views.Controls"
             x:Class="SCADA.Views.TrajectoryTabView"
             x:DataType="vm:TrajectoryViewModel">

    <Grid ColumnDefinitions="450,*" Margin="16" ColumnSpacing="16">
        <!-- Left Column: Trajectory Planner Controls -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Margin="0,0,8,0">
                
                <!-- Trajectory Configuration Card -->
                <Border Background="#1E293B" CornerRadius="8" Padding="14" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="📐 THIẾT KẾ QUỸ ĐẠO (TRAJECTORY PLANNER)" FontWeight="Bold" FontSize="13" Foreground="#38BDF8"/>

                        <!-- Profile Type Selection -->
                        <ComboBox ItemsSource="{Binding ProfileTypes}"
                                  SelectedIndex="{Binding SelectedProfileIndex}"
                                  HorizontalAlignment="Stretch" Height="32"/>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Thời gian T (giây):" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,2"/>
                                <NumericUpDown Value="{Binding Config.Duration}" Minimum="0.5" Maximum="30.0" Increment="0.5" FormatString="0.0 s"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <CheckBox Content="Lặp lại (Loop)" IsChecked="{Binding Config.IsLooping}" Foreground="#F8FAFC" FontSize="12" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="#334155" Margin="0,2"/>

                        <!-- Start Joint Angles -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Điểm Đầu (Start Pose):" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Lấy vị trí hiện tại" Command="{Binding SetStartFromCurrentCommand}" Background="#334155" Foreground="White" Padding="6,2" FontSize="10"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Q1 (°)" FontSize="10" Foreground="#64748B"/>
                                <NumericUpDown Value="{Binding Config.StartQ1}" FormatString="0.0" Height="28"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Q2 (°)" FontSize="10" Foreground="#64748B"/>
                                <NumericUpDown Value="{Binding Config.StartQ2}" FormatString="0.0" Height="28"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Q3 (°)" FontSize="10" Foreground="#64748B"/>
                                <NumericUpDown Value="{Binding Config.StartQ3}" FormatString="0.0" Height="28"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Q4 (°)" FontSize="10" Foreground="#64748B"/>
                                <NumericUpDown Value="{Binding Config.StartQ4}" FormatString="0.0" Height="28"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="#334155" Margin="0,2"/>

                        <!-- Target Joint Angles -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Điểm Đích (Target Pose):" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Lấy vị trí hiện tại" Command="{Binding SetEndFromCurrentCommand}" Background="#334155" Foreground="White" Padding="6,2" FontSize="10"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Q1 (°)" FontSize="10" Foreground="#64748B"/>
                                <NumericUpDown Value="{Binding Config.EndQ1}" FormatString="0.0" Height="28"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Q2 (°)" FontSize="10" Foreground="#64748B"/>
                                <NumericUpDown Value="{Binding Config.EndQ2}" FormatString="0.0" Height="28"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Q3 (°)" FontSize="10" Foreground="#64748B"/>
                                <NumericUpDown Value="{Binding Config.EndQ3}" FormatString="0.0" Height="28"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Q4 (°)" FontSize="10" Foreground="#64748B"/>
                                <NumericUpDown Value="{Binding Config.EndQ4}" FormatString="0.0" Height="28"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="⚡ Tính toán &amp; Khởi tạo Quỹ đạo" Command="{Binding GenerateTrajectoryCommand}"
                                Background="#0284C7" Foreground="White" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Height="36" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Execution Player Controller Card -->
                <Border Background="#1E293B" CornerRadius="8" Padding="14" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="▶️ ĐIỀU KHIỂN CHẠY QUỸ ĐẠO (TRAJECTORY RUNNER)" FontWeight="Bold" FontSize="13" Foreground="#38BDF8"/>
                        
                        <!-- Progress Slider -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="{Binding CurrentTime, StringFormat='{}{0:F2}s'}" Foreground="#38BDF8" FontWeight="Bold" VerticalAlignment="Center" Width="40"/>
                            <Slider Grid.Column="1" Minimum="0.0" Maximum="{Binding Config.Duration}" Value="{Binding CurrentTime}" IsEnabled="False"/>
                            <TextBlock Grid.Column="2" Text="{Binding Config.Duration, StringFormat='{}{0:F1}s'}" Foreground="#94A3B8" VerticalAlignment="Center" Width="40"/>
                        </Grid>

                        <!-- Player Buttons -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Content="▶ Thực thi (Play)" Command="{Binding PlayCommand}" Background="#059669" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="36" FontWeight="SemiBold"/>
                            <Button Grid.Column="1" Content="⏸ Tạm dừng" Command="{Binding PauseCommand}" Background="#D97706" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="36" FontWeight="SemiBold"/>
                            <Button Grid.Column="2" Content="⏹ Dừng (Stop)" Command="{Binding StopCommand}" Background="#DC2626" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="36" FontWeight="SemiBold"/>
                        </Grid>

                        <TextBlock Text="{Binding TrajectoryStatusMessage}" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Right Column: Waveform Telemetry Charts -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <!-- Chart Selector Toolbar -->
            <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="10,6" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Đồ thị:" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0"/>
                        <Button Content="Góc khớp Q1-Q4" Command="{Binding SelectChartCommand}" CommandParameter="Positions" Background="#334155" Foreground="White" Padding="8,4" FontSize="11"/>
                        <Button Content="Vận tốc góc q̇" Command="{Binding SelectChartCommand}" CommandParameter="Velocities" Background="#334155" Foreground="White" Padding="8,4" FontSize="11"/>
                        <Button Content="Mô-men Torque τ" Command="{Binding SelectChartCommand}" CommandParameter="Torques" Background="#334155" Foreground="White" Padding="8,4" FontSize="11"/>
                        <Button Content="Tọa độ Đề-các (X,Y,Z)" Command="{Binding SelectChartCommand}" CommandParameter="Cartesian" Background="#334155" Foreground="White" Padding="8,4" FontSize="11"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding ChartTitle}" Foreground="#38BDF8" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
                </Grid>
            </Border>

            <!-- Chart Control -->
            <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" BorderBrush="#334155" BorderThickness="1">
                <controls:TelemetryChartControl DataPoints="{Binding TrajectoryPoints}"
                                                DataType="{Binding SelectedChartType}"
                                                CurrentTime="{Binding CurrentTime}"
                                                Title="{Binding ChartTitle}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
