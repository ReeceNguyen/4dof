<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SCADA.ViewModels"
             xmlns:m="using:SCADA.Models"
             x:Class="SCADA.Views.ConnectionTabView"
             x:DataType="vm:ConnectionViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid ColumnDefinitions="420,*" Margin="16" ColumnSpacing="16">
            <!-- Left Column: Connection Settings & Commands -->
            <StackPanel Grid.Column="0" Spacing="16">
                <!-- Hardware Config Card -->
                <Border Background="#1E293B" CornerRadius="8" Padding="16" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="📡 THÔNG SỐ KẾT NỐI MODBUS TCP" FontWeight="Bold" FontSize="14" Foreground="#38BDF8"/>
                        
                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Địa chỉ IP PLC:" VerticalAlignment="Center" Foreground="#94A3B8"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.IpAddress}" PlaceholderText="192.168.1.100"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Cổng Port:" VerticalAlignment="Center" Foreground="#94A3B8"/>
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Config.Port}" Minimum="1" Maximum="65535" FormatString="0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Modbus Unit ID:" VerticalAlignment="Center" Foreground="#94A3B8"/>
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Config.UnitId}" Minimum="1" Maximum="255" FormatString="0"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Watchdog Timeout:" VerticalAlignment="Center" Foreground="#94A3B8"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <NumericUpDown Value="{Binding Config.WatchdogTimeoutMs}" Minimum="100" Maximum="10000" Increment="500" Width="160" FormatString="0"/>
                                <TextBlock Text="ms" VerticalAlignment="Center" Foreground="#64748B"/>
                            </StackPanel>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Tần số Polling:" VerticalAlignment="Center" Foreground="#94A3B8"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <NumericUpDown Value="{Binding Config.PollingIntervalMs}" Minimum="10" Maximum="2000" Increment="10" Width="160" FormatString="0"/>
                                <TextBlock Text="ms" VerticalAlignment="Center" Foreground="#64748B"/>
                            </StackPanel>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Chế độ Giả lập:" VerticalAlignment="Center" Foreground="#94A3B8"/>
                            <ToggleSwitch Grid.Row="5" Grid.Column="1" IsChecked="{Binding Config.IsSimulationMode}"
                                          OnContent="Virtual OPTA PLC" OffContent="Physical Hardware"/>
                        </Grid>

                        <Separator Background="#334155" Margin="0,4"/>

                        <!-- Connect / Disconnect Buttons -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Command="{Binding ConnectCommand}"
                                    Background="#059669" Foreground="White" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" Height="36" FontWeight="SemiBold">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="⚡"/>
                                    <TextBlock Text="Kết nối (Connect)"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1" Command="{Binding DisconnectCommand}"
                                    Background="#DC2626" Foreground="White" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" Height="36" FontWeight="SemiBold">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="🔌"/>
                                    <TextBlock Text="Ngắt kết nối"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Diagnostics & Status Card -->
                <Border Background="#1E293B" CornerRadius="8" Padding="16" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="🩺 TÌNH TRẠNG KẾT NỐI &amp; HEARTBEAT" FontWeight="Bold" FontSize="14" Foreground="#38BDF8"/>
                        
                        <Border Background="#0F172A" CornerRadius="6" Padding="12" BorderBrush="#334155" BorderThickness="1">
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Trạng thái:" Foreground="#94A3B8" FontWeight="SemiBold"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="12" Height="12" Fill="{Binding StatusColor}"/>
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusColor}" FontWeight="Bold"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Độ trễ Ping:" Foreground="#94A3B8"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LatencyMs, StringFormat='{}{0:F1} ms'}" Foreground="#F8FAFC"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Heartbeat Counter:" Foreground="#94A3B8"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding HeartbeatCounter}" Foreground="#38BDF8" FontWeight="Bold"/>
                                    <Ellipse Width="8" Height="8" Fill="{Binding IsHeartbeatActive, Converter={x:Null}}" 
                                             IsVisible="{Binding IsHeartbeatActive}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Gói tin TX / RX:" Foreground="#94A3B8"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Foreground="#F8FAFC">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="TX: {0} | RX: {1}">
                                            <Binding Path="PacketsSent"/>
                                            <Binding Path="PacketsReceived"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Test Manual Register Write Card -->
                <Border Background="#1E293B" CornerRadius="8" Padding="16" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="✍️ GHI THANH GHI THỦ CÔNG (TESTING)" FontWeight="Bold" FontSize="14" Foreground="#38BDF8"/>
                        
                        <Grid ColumnDefinitions="110,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Địa chỉ thanh ghi:" VerticalAlignment="Center" Foreground="#94A3B8"/>
                            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding SelectedRegisterAddress}" Minimum="0" Maximum="99" FormatString="0"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Giá trị UInt16:" VerticalAlignment="Center" Foreground="#94A3B8"/>
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding WriteRegisterValue}" Minimum="0" Maximum="65535" FormatString="0"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="Ghi Int16" Command="{Binding WriteRegisterCommand}" Background="#2563EB" Foreground="White"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Giá trị Float32:" VerticalAlignment="Center" Foreground="#94A3B8"/>
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding WriteFloatValue}" Increment="1.0" FormatString="0.00"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="Ghi Float" Command="{Binding WriteFloatRegisterCommand}" Background="#0284C7" Foreground="White"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right Column: Register Inspector & Live Logs -->
            <Grid Grid.Column="1" RowDefinitions="*,260" RowSpacing="16">
                <!-- Modbus Register Table -->
                <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="16" BorderBrush="#334155" BorderThickness="1">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="📋 BẢNG THANH GHI MODBUS (HOLDING REGISTERS - OPTA CODESYS)" FontWeight="Bold" FontSize="14" Foreground="#38BDF8" Margin="0,0,0,10"/>
                        
                        <DataGrid Grid.Row="1" ItemsSource="{Binding RegisterList}" AutoGenerateColumns="False"
                                  IsReadOnly="True" GridLinesVisibility="All" Background="#0F172A"
                                  BorderBrush="#334155" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Địa chỉ (Address)" Binding="{Binding Address}" Width="120"/>
                                <DataGridTextColumn Header="Tên (Name)" Binding="{Binding Name}" Width="150"/>
                                <DataGridTextColumn Header="Kiểu dữ liệu" Binding="{Binding DataType}" Width="100"/>
                                <DataGridTextColumn Header="Truy cập" Binding="{Binding AccessType}" Width="90"/>
                                <DataGridTextColumn Header="Giá trị hiện tại" Binding="{Binding FormattedValue}" Width="130"/>
                                <DataGridTextColumn Header="Đơn vị" Binding="{Binding Unit}" Width="70"/>
                                <DataGridTextColumn Header="Mô tả chức năng" Binding="{Binding Description}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Communication Logs -->
                <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="16" BorderBrush="#334155" BorderThickness="1">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBlock Grid.Column="0" Text="📜 NHẬT KÝ TRUYỀN THÔNG (COMMUNICATION LOGS)" FontWeight="Bold" FontSize="14" Foreground="#38BDF8"/>
                            <Button Grid.Column="1" Content="Xóa Log" Command="{Binding ClearLogsCommand}" Background="#334155" Foreground="White" Height="26" Padding="8,2"/>
                        </Grid>

                        <ListBox Grid.Row="1" ItemsSource="{Binding LogList}" Background="#090D16" BorderBrush="#334155" BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="m:LogMessage">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding FormattedTimestamp}" Foreground="#64748B" FontSize="11" FontFamily="Monospace"/>
                                        <TextBlock Text="{Binding Level}" Foreground="{Binding ColorHex}" FontWeight="Bold" FontSize="11" Width="55"/>
                                        <TextBlock Text="{Binding Message}" Foreground="#E2E8F0" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
